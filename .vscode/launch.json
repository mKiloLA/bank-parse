{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Statement Parser",
            "type": "debugpy",
            "request": "launch",
            "module": "statement_parser",
            "console": "integratedTerminal"
        },
        {
            "name": "Run Unit Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-q"],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Run Flake8",
            "type": "debugpy",
            "request": "launch",
            "module": "flake8",
            "args": ["StatementParser.py", "statement_parser", "tests"],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Check Black Formatting",
            "type": "debugpy",
            "request": "launch",
            "module": "black",
            "args": ["--check", "StatementParser.py", "statement_parser", "tests"],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Compile Python Package",
            "type": "debugpy",
            "request": "launch",
            "module": "compileall",
            "args": ["-q", "statement_parser"],
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}